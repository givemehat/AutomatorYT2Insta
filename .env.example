# =================================================================
# AutomatorYT2Insta Configuration
# =================================================================

# Application Mode
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-string
BASE_URL=http://localhost:8000
PUBLIC_MEDIA_URL=http://localhost:8000  # For Instagram API callback/container fetch: use Cloudflare Tunnel or ngrok

# Operating Mode: SAFE (Human approval via dashboard) or FULL_AUTO (Autonomous publishing above threshold)
AUTOMATION_MODE=SAFE
AUTO_PUBLISH_THRESHOLD=0.85
MAX_REEL_DURATION_SECONDS=90
MIN_CLIP_DURATION_SECONDS=15

# Video Processing & Reframe Settings
REFRAME_STYLE=smart_face_track  # Options: smart_face_track, blur_stack, center_crop
ENABLE_SUBTITLES=True
SUBTITLE_STYLE=karaoke_highlight  # Options: karaoke_highlight, classic_yellow, bold_clean

# Database & Storage Cache
DATABASE_URL=sqlite:///./automator.db
STORAGE_DIR=./storage

# YouTube Data API v3 & Ingestion (Web Scraping fallback works even without API Key!)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_POLL_INTERVAL_MINUTES=30

# AI Strategic Engine (Gemini / OpenAI / Anthropic)
LLM_PROVIDER=gemini  # Options: gemini, openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text / Transcription Engine
TRANSCRIPTION_ENGINE=gemini  # Options: gemini, whisper_api, faster_whisper, youtube_scrape
WHISPER_MODEL_SIZE=base

# Instagram Graph API (Meta for Developers)
# Prerequisites: Instagram Professional/Creator account connected to a Facebook Page
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
META_APP_ID=
META_APP_SECRET=
META_USER_ACCESS_TOKEN=

# Cloud Storage (Google Drive / S3 / Local)
STORAGE_BACKEND=local  # Options: local, gdrive, s3
GOOGLE_DRIVE_FOLDER_ID=  # Optional: Folder ID in Google Drive (service account key in google_drive_credentials.json)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
